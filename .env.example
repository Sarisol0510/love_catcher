# =============================================================================
# 러브캐처 (Love Catcher) - 환경 설정 템플릿 (.env.example)
# =============================================================================
# 사용 방법:
# 1. 이 파일을 복사하여 프로젝트 루트에 '.env' 이름으로 저장하세요.
#    (PowerShell: Copy-Item .env.example .env)
# 2. 본인의 Firebase 프로젝트 ID와 부스 계좌 정보로 수정하세요.
# 3. .env 파일은 절대 Git에 커밋하거나 외부에 공유하지 마세요.
# =============================================================================

# [필수] Firebase 프로젝트 고유 ID (Firestore Database)
# Firebase 콘솔 (https://console.firebase.google.com) -> 프로젝트 설정 -> 일반 -> "프로젝트 ID"
FIREBASE_PROJECT_ID=your-firebase-project-id

# [선택] 현장 결제 화면에 표시될 계좌번호 및 예금주 안내 문구
# 비워두거나 미설정 시 기본 플레이스홀더 문구가 화면에 표시됩니다.
BANK_ACCOUNT_INFO=🏦 토스뱅크 0000-0000-0000 홍길동 🏦
